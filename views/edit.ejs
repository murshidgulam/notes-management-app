<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="main w-full min-h-screen bg-zinc-900 p-10 text-white">
        <a href="/" class="text-blue-500 inline-block mb-10">Go back to home.</a>

        <form action="/edit" method="post">
            <input class="block p-5 py-2 rounded-md outline-none bg-zinc-800 text-zinc-500 w-1/4" type="text"
                placeholder="Previous Name" name="previous" value="<%= filename %>" >
            <input class="block mt-2 px-5 py-2 rounded-md outline-none bg-zinc-800 w-1/4 mt-2" type="text"
                placeholder="New Name" name="new"></textarea>
            <input class="mt-2 bg-yellow-600 px-5 py-2 rounded-md" type="submit" value="Update Filename">
        </form>
    </div>
    <script src="/javascripts/script.js"></script>
</body>

</html>